FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    cmake \
    ninja-build \
    git \
    python3 \
    python3-pip \
    pkg-config \
    # Tooling
    clang \
    clang-tidy \
    lcov \
    # Wayland / XKB (OpenCV + Conan deps)
    xkb-data \
    libxkbcommon-dev \
    wayland-protocols \
    libwayland-dev \
    && rm -rf /var/lib/apt/lists/*

# Conan 2
RUN pip3 install --break-system-packages conan==2.* && conan --version

WORKDIR /work

COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
